@model DoAnNhom08LTW.Models.ViewModels.Admin.ProductFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_admin.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 900px;">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">Chỉnh sửa sản phẩm @Model.MaSanPham</h5>
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
    <div class="card-body p-4">
        <form asp-area="Admin" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="NgayTao" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaSanPham" class="form-label fw-medium"></label>
                    <input asp-for="MaSanPham" class="form-control bg-light" readonly />
                </div>

                <div class="col-md-8">
                    <label asp-for="TenSanPham" class="form-label fw-medium"></label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ThuongHieu" class="form-label fw-medium"></label>
                    <input asp-for="ThuongHieu" class="form-control" />
                    <span asp-validation-for="ThuongHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MaDanhMucId" class="form-label fw-medium"></label>
                    <select asp-for="MaDanhMucId" asp-items="ViewBag.Categories" class="form-select"></select>
                    <span asp-validation-for="MaDanhMucId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MaKhuyenMaiId" class="form-label fw-medium"></label>
                    <select asp-for="MaKhuyenMaiId" asp-items="ViewBag.Promotions" class="form-select">
                        <option value="">-- Không áp dụng khuyến mãi --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="GiaBan" class="form-label fw-medium"></label>
                    <input asp-for="GiaBan" type="number" step="1000" min="0" class="form-control" />
                    <span asp-validation-for="GiaBan" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoLuongTon" class="form-label fw-medium"></label>
                    <input asp-for="SoLuongTon" type="number" min="0" class="form-control" />
                    <span asp-validation-for="SoLuongTon" class="text-danger small"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                {
                    <div class="col-12">
                        <label class="form-label fw-medium d-block">Hình ảnh hiện tại</label>
                        <img src="@Model.HinhAnh" alt="@Model.TenSanPham"
                             style="width: 110px; height: 110px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb;" />
                    </div>
                }

                <div class="col-md-6">
                    <label asp-for="HinhAnhFile" class="form-label fw-medium">Tải ảnh mới (tùy chọn)</label>
                    <input asp-for="HinhAnhFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                </div>

                <div class="col-md-6">
                    <label asp-for="HinhAnh" class="form-label fw-medium">Đường dẫn hình ảnh</label>
                    <input asp-for="HinhAnh" class="form-control" />
                    <span asp-validation-for="HinhAnh" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-medium"></label>
                    <textarea asp-for="MoTa" rows="4" class="form-control"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="DangBan" class="form-check-input" type="checkbox" />
                        <label asp-for="DangBan" class="form-check-label fw-medium">Sản phẩm đang được mở bán</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-light border">Hủy</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-save me-1"></i>Cập nhật sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
