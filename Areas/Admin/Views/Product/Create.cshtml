@model DoAnNhom08LTW.Models.ViewModels.Admin.ProductFormViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_admin.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 900px;">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">Thông tin sản phẩm mới</h5>
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
    </div>
    <div class="card-body p-4">
        <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            }

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="TenSanPham" class="form-label fw-medium"></label>
                    <input asp-for="TenSanPham" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ThuongHieu" class="form-label fw-medium"></label>
                    <input asp-for="ThuongHieu" class="form-control" placeholder="Apple, Anker, Baseus..." />
                    <span asp-validation-for="ThuongHieu" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaDanhMucId" class="form-label fw-medium"></label>
                    <select asp-for="MaDanhMucId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="MaDanhMucId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaKhuyenMaiId" class="form-label fw-medium"></label>
                    <select asp-for="MaKhuyenMaiId" asp-items="ViewBag.Promotions" class="form-select">
                        <option value="">-- Không áp dụng khuyến mãi --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="GiaBan" class="form-label fw-medium"></label>
                    <input asp-for="GiaBan" type="number" step="1000" min="0" class="form-control" />
                    <span asp-validation-for="GiaBan" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoLuongTon" class="form-label fw-medium"></label>
                    <input asp-for="SoLuongTon" type="number" min="0" class="form-control" />
                    <span asp-validation-for="SoLuongTon" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HinhAnhFile" class="form-label fw-medium"></label>
                    <input asp-for="HinhAnhFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <div class="form-text">Hỗ trợ .jpg, .png, .webp, .gif (tối đa 5MB).</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="HinhAnh" class="form-label fw-medium">Hoặc đường dẫn ảnh</label>
                    <input asp-for="HinhAnh" class="form-control" placeholder="/images/sanpham/ten-anh.jpg" />
                    <span asp-validation-for="HinhAnh" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-medium"></label>
                    <textarea asp-for="MoTa" rows="4" class="form-control" placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="DangBan" class="form-check-input" type="checkbox" />
                        <label asp-for="DangBan" class="form-check-label fw-medium">Mở bán ngay trên cửa hàng</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-light border">Hủy</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-save me-1"></i>Lưu sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
