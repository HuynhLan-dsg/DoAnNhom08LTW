@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<DoAnNhom08LTW.Models.DanhMuc>
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_admin.cshtml";
    string? keyword = ViewBag.Keyword as string;
    bool? isActive = ViewBag.IsActive as bool?;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h5 class="mb-0 fw-bold text-dark">Danh sách danh mục (@Model.Count())</h5>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <form asp-area="Admin" asp-controller="Category" asp-action="Index" method="get" class="d-flex flex-wrap gap-2">
                <input type="text" name="keyword" value="@keyword" class="form-control form-control-sm" style="width: 220px;" placeholder="Tìm mã hoặc tên danh mục..." />
                <select name="isActive" class="form-select form-select-sm w-auto">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(isActive == true)">Đang hoạt động</option>
                    <option value="false" selected="@(isActive == false)">Tạm ẩn</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-search"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(keyword) || isActive.HasValue)
                {
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-sm btn-light border">Đặt lại</a>
                }
            </form>
            <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-sm btn-danger">
                <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã DM</th>
                        <th>Hình ảnh</th>
                        <th>Tên danh mục</th>
                        <th class="text-center">Số sản phẩm</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var productCount = item.SanPhams?.Count ?? 0;
                            <tr>
                                <td class="ps-4 fw-semibold">@(string.IsNullOrEmpty(item.MaDanhMuc) ? $"DM{item.Id:D4}" : item.MaDanhMuc)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                    {
                                        <img src="@item.HinhAnh" alt="@item.TenDanhMuc"
                                             style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                                             style="width: 48px; height: 48px; border-radius: 8px; border: 1px solid #e5e7eb;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-medium text-dark">@item.TenDanhMuc</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@productCount sản phẩm</span>
                                </td>
                                <td>
                                    @if (item.DangHoatDong)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-eye-slash me-1"></i>Tạm ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <form asp-area="Admin" asp-controller="Category" asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="@(item.DangHoatDong ? "Tạm ẩn" : "Kích hoạt")">
                                                <i class="bi @(item.DangHoatDong ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post" class="d-inline"
                                              data-name="@item.TenDanhMuc"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa danh mục ' + this.dataset.name + ' không?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa danh mục">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không tìm thấy danh mục nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
