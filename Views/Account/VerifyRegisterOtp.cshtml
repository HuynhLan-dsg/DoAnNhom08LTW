@model DoAnNhom08LTW.Models.ViewModels.VerifyLoginOtpViewModel
@{
    ViewData["Title"] = "Xác thực mã OTP";
    Layout = "~/Views/Shared/_Layout_user.cshtml";
}

<style>
    .otp-container {
        max-width: 440px;
        margin: 70px auto;
        padding: 40px 32px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
        text-align: center;
    }

    .otp-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        background: rgba(219, 68, 68, 0.1);
        color: #DB4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .otp-title {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
    }

    .otp-desc {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    .otp-input {
        width: 100%;
        padding: 14px;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 10px;
        text-align: center;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.2s;
    }

    .otp-input:focus {
        border-color: #DB4444;
    }

    .btn-verify {
        width: 100%;
        margin-top: 24px;
        padding: 13px;
        background-color: #DB4444;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-verify:hover {
        background-color: #c53737;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        font-size: 14px;
        color: #6b7280;
        text-decoration: none;
    }

    .back-link:hover {
        color: #DB4444;
        text-decoration: underline;
    }
</style>

<div class="otp-container">
    <div class="otp-icon">
        <i class="bi bi-shield-lock"></i>
    </div>
    <h2 class="otp-title">Xác thực đăng nhập</h2>
    <p class="otp-desc">
        Chúng tôi đã gửi mã xác thực gồm <strong>6 chữ số</strong> đến địa chỉ email của bạn. Vui lòng kiểm tra hộp thư (hoặc thư mục Spam) và nhập mã bên dưới.
    </p>

    <form asp-controller="Account" asp-action="VerifyRegisterOtp" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 14px;"></div>

        <div>
            <input asp-for="OTP"
                   class="otp-input"
                   maxlength="6"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   placeholder="••••••"
                   autocomplete="one-time-code"
                   autofocus />
            <span asp-validation-for="OTP" class="text-danger d-block mt-2" style="font-size: 13px;"></span>
        </div>

        <button type="submit" class="btn-verify">Xác nhận OTP</button>
    </form>

    <a asp-controller="Account" asp-action="Login" class="back-link">
        ← Quay lại trang đăng nhập
    </a>
</div>
