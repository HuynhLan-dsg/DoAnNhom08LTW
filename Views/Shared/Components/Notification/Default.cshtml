@model DoAnNhom08LTW.Models.ViewModels.Admin.NotificationViewModel

@if (Model.Items.Any())
{
    <div class="table-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-bell-fill text-danger me-2"></i>Thông báo cần xử lý
            </h5>
            <span class="badge bg-danger rounded-pill">@Model.TotalAlertCount cảnh báo</span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <a asp-area="@item.Area"
                   asp-controller="@item.Controller"
                   asp-action="@item.Action"
                   asp-all-route-data="item.RouteValues"
                   class="list-group-item list-group-item-action px-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi @item.IconClass fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">@item.Title</div>
                            <div class="text-muted small">@item.Message</div>
                        </div>
                    </div>
                    <span class="badge @item.BadgeClass">@item.BadgeText</span>
                </a>
            }
        </div>
    </div>
}
