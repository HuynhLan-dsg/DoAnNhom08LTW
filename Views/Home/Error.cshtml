@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
    Layout = "~/Views/Shared/_Layout_user.cshtml";
}

<div style="max-width: 600px; margin: 80px auto; text-align: center; padding: 40px 20px; background: #fff; border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.08);">
    <h1 style="font-size: 64px; color: #DB4444; margin: 0;">500</h1>
    <h2 style="margin: 15px 0; color: #333;">Đã xảy ra sự cố hệ thống</h2>
    <p style="color: #666; margin-bottom: 25px;">
        Rất tiếc, hệ thống đang gặp sự cố trong quá trình xử lý yêu cầu của bạn. Đội ngũ kỹ thuật đã ghi nhận lỗi này.
    </p>

    @if (Model?.ShowRequestId == true)
    {
        <p style="font-size: 13px; color: #888; margin-bottom: 25px;">
            <strong>Mã tra cứu lỗi (Request ID):</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index"
       style="background: #DB4444; color: #fff; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-weight: 500;">
        Quay về trang chủ
    </a>
</div>